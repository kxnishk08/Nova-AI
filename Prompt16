dotnet user-secrets set "AzureOpenAI:ChatDeployment" "gpt-4o" --project .\src\NovaBanking.Api

dotnet run --project .\src\NovaBanking.Api

$body = @{
    message = "What is the minimum balance for a savings account?"
} | ConvertTo-Json

Invoke-RestMethod `
    -Uri "http://localhost:5146/api/ai/ask" `
    -Method Post `
    -ContentType "application/json" `
    -Body $body

