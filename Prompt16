dotnet user-secrets set "AzureAiSearch:EmbeddingDeployment" "text-embedding-3-small" --project .\src\NovaBanking.Api

dotnet user-secrets set "AzureAiSearch:OpenAiEndpoint" "https://kanishksharma-7060-resource.services.ai.azure.com" --project .\src\NovaBanking.Api



dotnet user-secrets set "AzureAiSearch:OpenAiApiKey" "YOUR_ACTUAL_EMBEDDING_RESOURCE_KEY" --project .\src\NovaBanking.Api

dotnet run --project .\src\NovaBanking.Api

$body = @{
    message = "What is the minimum balance for a savings account?"
} | ConvertTo-Json

Invoke-RestMethod `
    -Uri "http://localhost:5146/api/ai/ask" `
    -Method Post `
    -ContentType "application/json" `
    -Body $body

