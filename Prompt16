$session = New-Object Microsoft.PowerShell.Commands.WebRequestSession

$body = @{
    customerNumber = "CUST0001"
    pin = "1111"
} | ConvertTo-Json

Invoke-WebRequest `
    -Uri "http://localhost:5146/api/auth/pin-login" `
    -Method Post `
    -ContentType "application/json" `
    -Body $body `
    -WebSession $session `
    -UseBasicParsing


$body = @{
    message = "What is my account balance?"
} | ConvertTo-Json

Invoke-RestMethod `
    -Uri "http://localhost:5146/api/ai/ask" `
    -Method Post `
    -ContentType "application/json" `
    -Body $body `
    -WebSession $session
